module Sql.Expr exposing (
  Finite,
  eq,
  gt,
  gte,
  ilike,
  like,
  lt,
  lte,
  per_variant,
  neq,
)

import Sql exposing (Expr(..))
import Encode exposing (Encodable, encode)


# The same comparisons `Sql` exposes, against another expression rather than a
# value you hold: a second column, `db_now`, an aggregate, anything already
# built. Import it qualified, so the call says which side it takes:
#
#   join(orders, (o) -> { p.id |> Expr.eq(o.person_id) })
#   where(s.expires_at |> Expr.gt(db_now))
def eq(left: Expr(a), right: Expr(a)) -> Expr(Bool)
  binary(left, " = ", right)
end


def neq(left: Expr(a), right: Expr(a)) -> Expr(Bool)
  binary(left, " <> ", right)
end


def gt(left: Expr(a), right: Expr(a)) -> Expr(Bool)
  binary(left, " > ", right)
end


def gte(left: Expr(a), right: Expr(a)) -> Expr(Bool)
  binary(left, " >= ", right)
end


def lt(left: Expr(a), right: Expr(a)) -> Expr(Bool)
  binary(left, " < ", right)
end


def lte(left: Expr(a), right: Expr(a)) -> Expr(Bool)
  binary(left, " <= ", right)
end


def like(e: Expr(String), pattern: Expr(String)) -> Expr(Bool)
  binary(e, " LIKE ", pattern)
end


def ilike(e: Expr(String), pattern: Expr(String)) -> Expr(Bool)
  binary(e, " ILIKE ", pattern)
end




def binary(left: Expr(a), op: String, right: Expr(b)) -> Expr(Bool)
  Expr(left.sql ++ op ++ right.sql, left.params ++ right.params)
end


# A type whose every value is known: a database enum, whose instance the schema
# generator writes next to its codec, and `Bool`.
interface Finite(a) with
  variants: List(a)
end


implements Finite(Bool) with
  variants: bool_variants
end


def bool_variants -> List(Bool)
  [True, False]
end


# A `CASE` with one arm per value of `e`, each arm what `branch` makes of it.
# `branch` is an ordinary function, so the `case` inside it is checked for
# every variant, and the SQL needs no `ELSE`:
#
#   t.kind |> Expr.per_variant((k) -> {
#     case k
#     in Income then tl.amount_cents
#     in Expense then neg(tl.amount_cents)
#     end
#   })
#   # (CASE t.kind WHEN ? THEN tl.amount_cents WHEN ? THEN -(tl.amount_cents) END)
def per_variant(e: Expr(a), branch: a -> Expr(b)) -> Expr(b)
  arms = variants |> List.map((v) -> { (encode(v), branch(v)) })
  whens = arms
    |> List.map((arm) -> { " WHEN ? THEN " ++ Tuple.second(arm).sql })
    |> String.concat
  params = arms
    |> List.and_then((arm) -> { [Tuple.first(arm)] ++ Tuple.second(arm).params })

  Expr("(CASE " ++ e.sql ++ whens ++ " END)", e.params ++ params)
end
