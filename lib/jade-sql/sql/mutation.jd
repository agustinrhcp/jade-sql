module Sql.Mutation exposing (
  Mutation,
  delete,
  execute,
  fetch_many,
  fetch_one,
  delete_all,
  insert,
  insert_all,
  Stamped,
  returning,
  stamped,
  timestamped,
  to_sql,
  update,
  filter,
  update_all,
  update_many,
)

import Sql exposing (
  Assignable,
  Assignment(..),
  Expr(..),
  ToSql,
  Selector(..),
  SqlError,
  Pk,
  Table,
  TableRef(..),
  set_,
  to_assigns,
)
import Sql.Query exposing (Q)
import Decode exposing (Value)
import Encode


type MutationKind
  = InsertK
  | UpdateK
  | DeleteK


struct Mutation(ret, c) = {
  kind: MutationKind,
  table: TableRef,
  cols: c,
  rows: List(List(Assignment)),
  wheres: List(Expr(Bool)),
  returning_selector: Selector(ret),
  from_: Maybe(Expr(Bool))
}


def insert(value: a, t: Table(c, m, k, o, r)) -> Mutation(Int, c)
  Mutation(
    InsertK,
    TableRef(t.name, t.alias_),
    t.alias_ |> t.cols,
    [to_assigns(value)],
    [],
    Selector([], []),
     Nothing,
  )
end


def insert_all(values: List(a), t: Table(c, m, k, o, r)) -> Mutation(Int, c)
  Mutation(
    InsertK,
    TableRef(t.name, t.alias_),
    t.alias_ |> t.cols,
    List.map(values, (v) -> { to_assigns(v) }),
    [],
    Selector([], []),
     Nothing,
  )
end


def update(value: a, t: Table(c, m, k, o, r), key: k) -> Mutation(Int, c)
  Mutation(
    UpdateK,
    TableRef(t.name, t.alias_),
    t.alias_ |> t.cols,
    [without_key(t.pk, to_assigns(value))],
    [key_predicate(t.pk, key)],
    Selector([], []),
     Nothing,
  )
end


def delete(t: Table(c, m, k, o, r), key: k) -> Mutation(Int, c)
  Mutation(
    DeleteK,
    TableRef(t.name, t.alias_),
    t.alias_ |> t.cols,
    [],
    [key_predicate(t.pk, key)],
    Selector([], []),
     Nothing,
  )
end


def filter(m: Mutation(ret, c), build: c -> Expr(Bool)) -> Mutation(ret, c)
  Mutation(
    m.kind,
    m.table,
    m.cols,
    m.rows,
    m.wheres ++ [m.cols |> build],
    m.returning_selector,
    m.from_,
  )
end


def update_all(
  t: Table(c, m, k, o, r),
  pred_fn: c -> Expr(Bool),
  build: c -> List(Assignment),
) -> Mutation(Int, c)
  cols_ = t.alias_ |> t.cols
  pred = cols_ |> pred_fn

  Mutation(
    UpdateK,
    TableRef(t.name, t.alias_),
    cols_,
    [cols_ |> build],
    [pred],
    Selector([], []),
     Nothing,
  )
end


def update_many(rows_: List((k, a)), t: Table(c, m, k, o, r)) -> Mutation(Int, c)
  rows = rows_ |> List.map((r) -> { keyed_assigns(t.pk, r) })

  Mutation(
    UpdateK,
    TableRef(t.name, t.alias_),
    t.alias_ |> t.cols,
    [source_assigns(t.pk, rows)],
    [pk_join(t.pk.columns)],
    Selector([], []),
    Just(source_of(t.name, rows)),
  )
end


# The key travels with each row so the JSON source carries the columns the
# join matches on, without the caller's struct having to hold them.
def keyed_assigns(pk_: Pk(c, k), r: (k, a)) -> List(Assignment)
  (key, value) = r

  key_assigns(pk_, key) ++ without_key(pk_, to_assigns(value))
end


def key_assigns(pk_: Pk(c, k), key: k) -> List(Assignment)
  List.zip(pk_.columns, key |> pk_.values)
    |> List.map((p) -> { Assignment(Tuple.first(p), "?", [Tuple.second(p)]) })
end


# One JSON parameter carries every row, so the statement is the same size
# for two rows or two hundred. json_populate_recordset gives the record
# the table's own column types, which is what makes a bare `?` legal in a
# position Postgres cannot otherwise infer.
def source_of(name: String, rows: List(List(Assignment))) -> Expr(Bool)
  Expr(
    "json_populate_recordset(null::" ++ name ++ ", ?::json) AS jade_src",
    [Encode.string(Encode.encode_to_string(json_rows(rows)))],
  )
end


def json_rows(rows: List(List(Assignment))) -> Value
  Encode.list(json_row(_), rows)
end


def json_row(row: List(Assignment)) -> Value
  Encode.object(row |> List.map((a) -> { Tuple.Tuple2(a.col, first_param(a)) }))
end


def first_param(a: Assignment) -> Value
  a.params |> List.head |> Maybe.with_default(Encode.null)
end


def source_assigns(pk_: Pk(c, k), rows: List(List(Assignment))) -> List(Assignment)
  rows
    |> touched_cols
    |> List.filter((col) -> { List.member?(pk_.columns, col) |> Basics.not })
    |> List.map((col) -> { Assignment(col, "jade_src." ++ col, []) })
end


def touched_cols(rows: List(List(Assignment))) -> List(String)
  rows
    |> List.concat
    |> List.map(.col)
    |> List.fold([], (seen, c) -> { List.member?(seen, c) ? seen : seen ++ [c] })
end


def pk_join(pk_columns: List(String)) -> Expr(Bool)
  Expr(
    pk_columns
      |> List.map((col) -> { "jade_tgt." ++ col ++ " = jade_src." ++ col })
      |> String.join(" AND "),
    [],
  )
end


def delete_all(t: Table(c, m, k, o, r), pred_fn: c -> Expr(Bool)) -> Mutation(Int, c)
  cols_ = t.alias_ |> t.cols
  pred = cols_ |> pred_fn

  Mutation(
    DeleteK,
    TableRef(t.name, t.alias_),
    cols_,
    [],
    [pred],
    Selector([], []),
     Nothing,
  )
end


def returning(m: Mutation(a, c), build: c -> Q(Selector(b))) -> Mutation(b, c)
  Mutation(
    m.kind,
    m.table,
    m.cols,
    m.rows,
    m.wheres,
    build(m.cols).result,
    m.from_,
  )
end


# Opt-in ActiveRecord-style timestamps: fills created_at + updated_at on
# insert and updated_at on update, with the app clock at execute time.
# The "$JADE_SQL_NOW$" token carries no param; the runtime swaps it for a
# single UTC timestamp literal per statement (so created_at == updated_at).
# A plain `insert`/`update` without this stays timestamp-free.
def timestamped(m: Mutation(ret, c)) -> Mutation(ret, c)
  case m.kind
  in InsertK then with_rows(m, List.map(m.rows, append_insert_stamps))
  in UpdateK then with_rows(m, List.map(m.rows, append_update_stamps))
  in DeleteK then m
  end
end


def append_insert_stamps(row: List(Assignment)) -> List(Assignment)
  row ++ [now_assignment("created_at"), now_assignment("updated_at")]
end


def append_update_stamps(row: List(Assignment)) -> List(Assignment)
  row ++ [now_assignment("updated_at")]
end


# A value plus the timestamps `created_at` and `updated_at`, filled with the
# app clock at execute time. A table that declares those columns NOT NULL
# requires them of the value being written, and this is what supplies them:
#
#   insert(NewPatient("Ada") |> stamped, patients)
#
# The struct being wrapped keeps its own `Assignable`; the stamps are appended
# to whatever it writes.
struct Stamped(a) = { value: a }


def stamped(value: a) -> Stamped(a)
  Stamped(value)
end


implements Assignable(Stamped(a)) with
  to_assigns: (s) -> {
    to_assigns(s.value) ++ [now_assignment("created_at"), now_assignment("updated_at")]
  },
end


def now_assignment(col: String) -> Assignment
  Assignment(col, "$JADE_SQL_NOW$", [])
end


def with_rows(m: Mutation(ret, c), rows: List(List(Assignment))) -> Mutation(ret, c)
  { m | rows: rows }
end


def without_key(pk_: Pk(c, k), assigns: List(Assignment)) -> List(Assignment)
  assigns |> List.filter((a) -> { List.member?(pk_.columns, a.col) |> Basics.not })
end


# The `WHERE` that selects one row by its key: `id = ?`, or
# `user_id = ? AND group_id = ?` for a composite key. Columns and values both
# come from the table's `Pk`, in the order `structure.sql` declares them, so a
# caller supplies a `k` and never a column name or an ordering.
def key_predicate(pk_: Pk(c, k), key: k) -> Expr(Bool)
  sql = pk_.columns
    |> List.map((col) -> { col ++ " = ?" })
    |> String.join(" AND ")

  Expr(sql, key |> pk_.values)
end


def render_row(row: List(Assignment)) -> String
  cols_part = row
    |> List.map((a) -> { a.value_sql })
    |> String.join(", ")

  "(" ++ cols_part ++ ")"
end


def returning_clause(s: Selector(ret)) -> String
  List.empty?(s.columns_sql) ? "" : " RETURNING " ++ String.join(s.columns_sql, ", ")
end


def insert_cols_str(rows: List(List(Assignment))) -> String
  case rows
  in [] then ""
  in [first | _]
    "(" ++ String.join(List.map(first, (a) -> { a.col }), ", ") ++ ")"
  end
end


def insert_params(rows: List(List(Assignment))) -> List(Value)
  List.fold(
    rows,
    [],
    (acc, row) -> { acc ++ List.fold(row, [], (acc2, a) -> { acc2 ++ a.params }) },
  )
end


def set_sqls_for(rows: List(List(Assignment))) -> List(String)
  case rows
  in [first | _] then List.map(first, (a) -> { a.col ++ " = " ++ a.value_sql })
  in [] then []
  end
end


def set_params_for(rows: List(List(Assignment))) -> List(Value)
  case rows
  in [first | _] then List.fold(first, [], (acc, a) -> { acc ++ a.params })
  in [] then []
  end
end


# A FROM'd UPDATE needs the target aliased: json_populate_recordset gives
# the source every column the table has, so a bare `id = jade_src.id` is
# ambiguous.
def target_ref(m: Mutation(ret, c)) -> String
  case m.from_
  in Nothing then m.table.name
  in Just(_) then m.table.name ++ " AS jade_tgt"
  end
end


def from_clause(from_: Maybe(Expr(Bool))) -> String
  case from_
  in Nothing then ""
  in Just(e) then " FROM " ++ e.sql
  end
end


def from_params(from_: Maybe(Expr(Bool))) -> List(Value)
  case from_
  in Nothing then []
  in Just(e) then e.params
  end
end


def where_sql(wheres: List(Expr(Bool))) -> String
  List.empty?(wheres)
    ? ""
    : " WHERE " ++ String.join(List.map(wheres, (w) -> { w.sql }), " AND ")
end


def where_params(wheres: List(Expr(Bool))) -> List(Value)
  List.fold(wheres, [], (acc, w) -> { acc ++ w.params })
end


def strip_table_alias(sql: String, alias_: String) -> String
  String.replace(sql, alias_ ++ ".", "")
end


def render_insert(m: Mutation(ret, c)) -> (String, List(Value))
  cols_str = insert_cols_str(m.rows)
  values_str = m.rows
    |> List.map(render_row)
    |> String.join(", ")
  returning_ = strip_table_alias(returning_clause(m.returning_selector), m.table.alias_)
  sql = "INSERT INTO "
    ++ m.table.name
    ++ " "
    ++ cols_str
    ++ " VALUES "
    ++ values_str
    ++ returning_

  Tuple.Tuple2(sql, insert_params(m.rows) ++ m.returning_selector.params)
end


def render_update(m: Mutation(ret, c)) -> (String, List(Value))
  sets = set_sqls_for(m.rows)

  List.empty?(sets) ? render_no_op_update(m) : render_update_set(m, sets)
end


def render_no_op_update(m: Mutation(ret, c)) -> (String, List(Value))
  where = strip_table_alias(where_sql(m.wheres), m.table.alias_)
  cols = List.empty?(m.returning_selector.columns_sql)
    ? "1"
    : strip_table_alias(
        String.join(m.returning_selector.columns_sql, ", "),
        m.table.alias_,
      )
  sql = "SELECT " ++ cols ++ " FROM " ++ m.table.name ++ where

  Tuple.Tuple2(sql, m.returning_selector.params ++ where_params(m.wheres))
end


def render_update_set(
  m: Mutation(ret, c),
  sets: List(String),
) -> (String, List(Value))
  set_clause = strip_table_alias(
    "SET " ++ String.join(sets, ", "),
    m.table.alias_,
  )
  where = strip_table_alias(where_sql(m.wheres), m.table.alias_)
  returning_ = strip_table_alias(returning_clause(m.returning_selector), m.table.alias_)
  sql = "UPDATE "
    ++ target_ref(m)
    ++ " "
    ++ set_clause
    ++ from_clause(m.from_)
    ++ where
    ++ returning_

  Tuple.Tuple2(
    sql,
    set_params_for(m.rows)
      ++ from_params(m.from_)
      ++ where_params(m.wheres)
      ++ m.returning_selector.params,
  )
end




def render_delete(m: Mutation(ret, c)) -> (String, List(Value))
  where = strip_table_alias(where_sql(m.wheres), m.table.alias_)
  returning_ = strip_table_alias(returning_clause(m.returning_selector), m.table.alias_)
  sql = "DELETE FROM "
    ++ m.table.name
    ++ where
    ++ returning_

  Tuple.Tuple2(sql, where_params(m.wheres) ++ m.returning_selector.params)
end


def to_sql(m: Mutation(ret, c)) -> (String, List(Value))
  case m.kind
  in InsertK then render_insert(m)
  in UpdateK then render_update(m)
  in DeleteK then render_delete(m)
  end
end


implements ToSql(Mutation(ret, c)) with
  to_sql: to_sql
end


# The number of rows the statement affected. Any `RETURNING` clause is
# rendered and discarded.
def execute(m: Mutation(ret, c)) -> Task(Int, SqlError)
  to_sql(m) |> Sql.execute_raw
end


# Decodes the single row a `returning` mutation gives back — the id of an
# insert, the new state of an update. A mutation with no `returning` selects
# nothing, so this errors with `NotFound`.
def fetch_one(m: Mutation(ret, c)) -> Task(ret, SqlError)
  to_sql(m) |> Sql.fetch_one_raw
end


# The same for a write that returns many rows, as `insert_all` and
# `update_all` do.
def fetch_many(m: Mutation(ret, c)) -> Task(List(ret), SqlError)
  to_sql(m) |> Sql.fetch_many_raw
end
